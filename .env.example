# sabbath-api — environment (names only; fill with real values, never commit .env)

# --- Database (Neon Postgres) ---
# Pooled endpoint — used by the running app (transactions verified on the pooler).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct/unpooled endpoint — used by drizzle-kit (migrations) and the seed script.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Runtime ---
PORT=3000
NODE_ENV=development

# --- better-auth ---
# Generate a strong secret: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Public base URL of THIS api (better-auth issues cookies for it).
BETTER_AUTH_URL=http://localhost:3000

# --- Internal service-to-service secret (shared with sabbath-bot) ---
# Generate: openssl rand -hex 24
INTERNAL_TOKEN=
# Base URL of sabbath-bot, for the api->bot /internal/announce edge.
BOT_ANNOUNCE_URL=http://localhost:3001

# --- CORS ---
# Origin of sabbath-web (better-auth trusted origin + CORS allow).
WEB_ORIGIN=http://localhost:5173

# --- Telegram deep-links ---
# Bot @username (without @) used to build t.me/<username>?start=<token> links.
TELEGRAM_BOT_USERNAME=your_bot

# --- Provider tooling / deploy (not read by the app at runtime) ---
NEON_API_KEY=
RAILWAY_API_KEY=
UPSTASH_API_KEY=
